type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type FileReference = 
 record {
   hash: text;
   path: text;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  /// Remove a document reference by path. Removing an unknown path is a no-op.
  dropFileReference: (path: text) -> ();
  execute: (qJson: text) -> (Result) query;
  /// Static Markdown documentation of the backend's public API.
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  /// Look up a single document reference by path. Traps when the path is unknown.
  getFileReference: (path: text) -> (FileReference) query;
  isCallerAdmin: () -> (bool) query;
  /// List every registered document reference.
  listFileReferences: () -> (vec FileReference) query;
  /// Register (or overwrite) the reference for a document path.
  registerFileReference: (path: text, hash: text) -> ();
  schema: () -> (text) query;
}
